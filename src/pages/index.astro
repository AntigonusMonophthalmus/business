---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Czech Business Template' } = Astro.props;

// Temporary placeholders. These will move to site.config.ts in a later step.
const business = {
  name: 'Název firmy',
  phone: '+420 123 456 789',
  email: 'info@example.cz',
  street: 'Ulice 123',
  city: '123 45 Město',
  ico: '12345678',
  dic: 'CZ12345678',
};

const navLinks = [
  { href: '#services', label: 'Služby' },
  { href: '#hours', label: 'Otevírací doba' },
  { href: '#gallery', label: 'Galerie' },
  { href: '#contact', label: 'Kontakt' },
];
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | {business.name}</title>
  </head>
  <body class="flex min-h-screen flex-col bg-white text-gray-900">
    <header class="border-b border-gray-200">
      <nav
        class="container mx-auto flex items-center justify-between p-4"
        aria-label="Hlavní navigace"
      >
        <a href="/" class="text-xl font-bold">{business.name}</a>

        <ul class="hidden gap-6 md:flex">
          {
            navLinks.map((link) => (
              <li>
                <a href={link.href} class="hover:text-blue-600">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>

        <button
          id="menu-toggle"
          type="button"
          class="rounded p-2 hover:bg-gray-100 md:hidden"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Otevřít menu"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-6 w-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"
            />
          </svg>
        </button>
      </nav>

      <ul
        id="mobile-menu"
        class="hidden flex-col gap-2 border-t border-gray-200 p-4 md:hidden"
      >
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href} class="block py-2 hover:text-blue-600">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="mt-12 border-t border-gray-200 bg-gray-50">
      <div class="container mx-auto grid gap-8 p-6 md:grid-cols-3">
        <div>
          <h2 class="font-semibold">{business.name}</h2>
          <address class="mt-2 not-italic text-sm text-gray-600">
            {business.street}<br />
            {business.city}
          </address>
        </div>

        <div>
          <h2 class="font-semibold">Kontakt</h2>
          <ul class="mt-2 space-y-1 text-sm text-gray-600">
            <li>
              <a href={`tel:${business.phone.replace(/\s/g, '')}`} class="hover:text-blue-600">
                {business.phone}
              </a>
            </li>
            <li>
              <a href={`mailto:${business.email}`} class="hover:text-blue-600">
                {business.email}
              </a>
            </li>
          </ul>
        </div>

        <div>
          <h2 class="font-semibold">Fakturační údaje</h2>
          <ul class="mt-2 space-y-1 text-sm text-gray-600">
            <li>IČO: {business.ico}</li>
            <li>DIČ: {business.dic}</li>
          </ul>
        </div>
      </div>
      <div class="border-t border-gray-200 py-4 text-center text-xs text-gray-500">
        © {new Date().getFullYear()} {business.name}
      </div>
    </footer>

    <script>
      const toggle = document.getElementById('menu-toggle');
      const menu = document.getElementById('mobile-menu');

      if (toggle && menu) {
        toggle.addEventListener('click', () => {
          const expanded = toggle.getAttribute('aria-expanded') === 'true';
          toggle.setAttribute('aria-expanded', String(!expanded));
          menu.classList.toggle('hidden');
        });
      }
    </script>
  </body>
</html>