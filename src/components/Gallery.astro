---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { getTranslations } from '../i18n/utils.js';

const { lang } = Astro.props;
const t = getTranslations(lang);

// Collect every image in src/assets/gallery at build time.
// Vite handles the imports; we just look them up by filename.
const imageModules = import.meta.glob(
  '../assets/gallery/*.{jpg,jpeg,png,webp}',
  { eager: true }
);

function getImage(filename) {
  const key = Object.keys(imageModules).find((k) =>
    k.endsWith(`/${filename}`)
  );
  return key ? imageModules[key].default : null;
}

const [galleryEntry] = await getCollection(
  'gallery',
  ({ data }) => data.lang === lang
);

const entries = galleryEntry?.data.images ?? [];

// Skip missing files; warn during dev so we notice.
const items = entries
  .map((entry) => ({ ...entry, image: getImage(entry.file) }))
  .filter((entry) => {
    if (!entry.image) {
      if (import.meta.env.DEV) {
        console.warn(`[Gallery] Image not found: ${entry.file}`);
      }
      return false;
    }
    return true;
  });
---

{
  items.length > 0 && (
    <section id="gallery" class="bg-gray-50 py-16">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold md:text-4xl">{t.sections.gallery}</h2>

        <ul class="mt-8 grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-4">
          {items.map((item) => (
            <li class="overflow-hidden rounded-lg">
              <figure>
                <Image
                  src={item.image}
                  alt={item.alt}
                  widths={[300, 600, 900]}
                  sizes="(min-width: 768px) 33vw, 50vw"
                  class="aspect-square w-full object-cover"
                />
                {item.caption && (
                  <figcaption class="mt-2 text-sm text-gray-600">
                    {item.caption}
                  </figcaption>
                )}
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}