---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site.config.js';
import { getTranslations } from '../i18n/utils.js';

const { lang } = Astro.props;
const t = getTranslations(lang);
const p = t.privacyPage;
---

<BaseLayout lang={lang} title={p.title}>
  <article class="container mx-auto max-w-3xl px-4 py-16">
    <h1 class="text-3xl font-bold md:text-4xl">{p.title}</h1>
    <p class="mt-2 text-sm text-gray-500">{p.lastUpdated}</p>

    <section class="mt-10">
      <h2 class="text-xl font-semibold">{p.controllerHeading}</h2>
      <p class="mt-3 text-gray-700">{p.controllerIntro}</p>
      <ul class="mt-2 space-y-1 text-gray-700">
        <li>{site.legalName}</li>
        <li>{site.street}, {site.city}</li>
        <li>IČO: {site.ico}</li>
        <li>
          <a href={`mailto:${site.email}`} class="text-blue-600 hover:underline">
            {site.email}
          </a>
        </li>
      </ul>
    </section>

    <section class="mt-8">
      <h2 class="text-xl font-semibold">{p.dataHeading}</h2>
      <p class="mt-3 text-gray-700">{p.dataIntro}</p>
      <ul class="mt-2 ml-6 list-disc space-y-1 text-gray-700">
        {p.dataItems.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="mt-8">
      <h2 class="text-xl font-semibold">{p.purposeHeading}</h2>
      <p class="mt-3 text-gray-700">{p.purposeBody}</p>
    </section>

    <section class="mt-8">
      <h2 class="text-xl font-semibold">{p.retentionHeading}</h2>
      <p class="mt-3 text-gray-700">{p.retentionBody}</p>
    </section>

    <section class="mt-8">
      <h2 class="text-xl font-semibold">{p.rightsHeading}</h2>
      <p class="mt-3 text-gray-700">{p.rightsIntro}</p>
      <ul class="mt-2 ml-6 list-disc space-y-1 text-gray-700">
        {p.rightsItems.map((item) => <li>{item}</li>)}
      </ul>
      <p class="mt-3 text-gray-700">
        {p.rightsContact}{' '}
        <a href={`mailto:${site.email}`} class="text-blue-600 hover:underline">
          {site.email}
        </a>.
      </p>
    </section>

    <section class="mt-8">
      <h2 class="text-xl font-semibold">{p.authorityHeading}</h2>
      <p class="mt-3 text-gray-700">{p.authorityBody}</p>
    </section>

    <section class="mt-8">
      <h2 class="text-xl font-semibold">{p.cookiesHeading}</h2>
      <p class="mt-3 text-gray-700">
        {site.privacy.analytics
          ? p.cookiesBodyWithAnalytics
          : p.cookiesBodyNoAnalytics}
      </p>
    </section>
  </article>
</BaseLayout>